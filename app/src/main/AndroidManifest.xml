<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
 <queries>
  <package android:name="com.linepaytw.upay"/>
  <package android:name="com.pxpayplus.app"/>
  <package android:name="com.paypal.android.p2pmobile"/>
 </queries>
 <application android:label="Pay Hub" android:theme="@android:style/Theme.Material.NoActionBar" android:usesCleartextTraffic="false">
